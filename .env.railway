# Railway Environment Variables — Hermes Agent
#
# Copy these into Railway dashboard → your service → Variables tab.
# Fill in YOUR_VALUES. Lines starting with # are comments, ignore them.
#
# Required to start:
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_NUMERIC_USER_ID
TERMINAL_ENV=local
HERMES_YOLO_MODE=1

# Future LLM providers — add these when you want to switch or add providers:
# NOUS_PORTAL_API_KEY=YOUR_NOUS_PORTAL_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# HERMES_INFERENCE_PROVIDER=auto
#   Options: auto | anthropic | nous | openrouter
#   "auto" picks the best available provider based on which keys are set.
#   Default when unset: auto

# Optional Telegram extras:
# TELEGRAM_HOME_CHANNEL=YOUR_CHAT_ID      # Default chat for cron job output
# TELEGRAM_HOME_CHANNEL_NAME=Tessa        # Display name for above

# Optional dashboard (exposes web UI on port 9119):
# HERMES_DASHBOARD=1
# HERMES_DASHBOARD_HOST=0.0.0.0
# PORT=9119
